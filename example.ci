  image: alpine:latest
  variables:
    SUBST_VARS: '${CI_REGISTRY_IMAGE} ${CI_COMMIT_REF_SLUG} ${CI_COMMIT_SHORT_SHA}'
  script:
    - apk add gettext openssh-client
    - envsubst "$SUBST_VARS" < docker-compose.yml > docker-compose.prod.yml
    - scp docker-compose.prod.yml server:/app/docker-compose.yml
    - ssh server "cd /app && docker-compose up -d"